{
  "name": "better-profiles",
  "displayName": "Better Profiles",
  "description": "grouping extensions and activating them only when needed",
  "publisher": "lyesrabhi",
  "version": "1.0.0",
  "repository": "https://github.com/lyesrabhi16/BetterProfiles.git",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "workspace",
    "ui"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "better-profiles.switchProfile",
        "title": "Switch Profile",
        "category": "Better Profiles"
      },
      {
        "command": "better-profiles.compareProfiles",
        "title": "Compare Extensions Across Profiles",
        "category": "Better Profiles"
      },
      {
        "command": "better-profiles.addToGroup",
        "title": "Add Extensions To Group…",
        "category": "Better Profiles"
      },
      {
        "command": "better-profiles.assignGroup",
        "title": "Give A Group To A Profile…",
        "category": "Better Profiles"
      },
      {
        "command": "better-profiles.syncProfile",
        "title": "Sync Profile With Its Groups…",
        "category": "Better Profiles"
      },
      {
        "command": "better-profiles.editGroups",
        "title": "Edit Groups File",
        "category": "Better Profiles"
      }
    ],
    "configuration": {
      "title": "Better Profiles",
      "properties": {
        "betterProfiles.storageFile": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "Advanced. Path to VS Code's `storage.json`, where profiles and their workspace associations are recorded. Leave empty to use the one next to this extension's global storage."
        },
        "betterProfiles.groupsFile": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "Where your extension groups are kept. Leave empty to use `groups.json` in this extension's global storage, which every profile shares. Point it into a dotfiles repository to version it."
        },
        "betterProfiles.codeCommand": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "Advanced. An executable to run instead of this VS Code's own command line (for example a custom build). Used to list and install extensions per profile. Leave empty to use the built-in one."
        },
        "betterProfiles.codeArgs": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "scope": "machine",
          "markdownDescription": "Advanced. Arguments that always come first when `#betterProfiles.codeCommand#` runs, for example `--user-data-dir` and `--extensions-dir` for a portable or non-default installation."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test",
    "test:unit": "npm run compile-tests && mocha --ui tdd \"out/test/unit/**/*.test.js\""
  },
  "devDependencies": {
    "@types/mocha": "^10.0.9",
    "@types/node": "20.x",
    "@types/vscode": "^1.95.0",
    "@typescript-eslint/eslint-plugin": "^8.10.0",
    "@typescript-eslint/parser": "^8.7.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "eslint": "^9.13.0",
    "mocha": "^10.8.2",
    "ts-loader": "^9.5.1",
    "typescript": "^5.6.3",
    "webpack": "^5.95.0",
    "webpack-cli": "^5.1.4"
  }
}
